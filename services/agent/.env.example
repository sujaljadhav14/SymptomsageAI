# SymptomSage Agent Service — Environment Variables
# Copy this file to .env and fill in real values.

# ---- LLM ----
# Google Gemini (primary)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp

# Ollama (local/offline fallback) — only needed if you want local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Which LLM provider to use: "gemini" | "ollama"
LLM_PROVIDER=gemini

# ---- External services (the agent calls these as tools) ----
# Node/Express backend (for email + image analysis fallback)
NODE_BACKEND_URL=http://localhost:3001

# Supabase (patient memory)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Maps Places (hospital/lab search)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# ---- Server ----
AGENT_PORT=8000
AGENT_HOST=0.0.0.0
# Comma-separated allowed origins for CORS
AGENT_CORS_ORIGINS=http://localhost:5173
